// Secrets.example.xcconfig
//
// TEMPLATE — copy this file to `Secrets.xcconfig` (same folder) and fill in
// your real values. `Secrets.xcconfig` is git-ignored so your keys never get
// committed. Then in Xcode: Project ▸ Info ▸ Configurations, set Debug/Release
// to use Secrets.xcconfig, and add matching keys to Info.plist.
//
// The anon (public) key is safe to ship in a client app; the service_role key
// is NOT — never put service_role here.

SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = your-anon-public-key-here
